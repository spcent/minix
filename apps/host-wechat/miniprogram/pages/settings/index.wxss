.header-menu {
  margin-bottom: 24rpx;
}

.profile-menu {
  background: rgba(252, 248, 242, 0.96);
}

.hero {
  margin-bottom: 24rpx;
}

.profile-hero {
  padding: 8rpx 0 4rpx;
}

.profile-card,
.profile-actions,
.profile-footer {
  background: rgba(255, 252, 248, 0.98);
}

.eyebrow {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: #7f5539;
}

.section-title {
  margin-top: 24rpx;
  margin-bottom: 8rpx;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: #7f5539;
}

.section-title:first-child {
  margin-top: 0;
}

.item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
}

.profile-actions .section-title {
  color: #5c677d;
}

.footer-nav {
  margin-top: 24rpx;
}
