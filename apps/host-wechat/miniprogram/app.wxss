.page {
  min-height: 100vh;
  padding: 32rpx;
  background:
    radial-gradient(circle at top left, #fff3df 0%, transparent 34%),
    linear-gradient(180deg, #f6efe6 0%, #eef7f4 100%);
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 16rpx 40rpx rgba(15, 23, 42, 0.08);
}

.header-menu {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.brand-block {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.brand-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #14213d;
}

.brand-subtitle {
  font-size: 22rpx;
  color: #5c677d;
  line-height: 1.5;
}

.menu-title {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: #5c677d;
  font-weight: 600;
}

.nav-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.nav-chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #f3f6fb;
  color: #5c677d;
  font-size: 22rpx;
}

.nav-chip-active {
  background: #123c69;
  color: #ffffff;
}

.nav-chip-link {
  color: #123c69;
  font-weight: 600;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #0f172a;
}

.subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #64748b;
}

.button {
  margin-top: 24rpx;
}

.footer-nav {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.footer-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #14213d;
}

.footer-copy {
  font-size: 24rpx;
  line-height: 1.6;
  color: #5c677d;
}

.item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}

.item:last-child {
  border-bottom: 0;
}
