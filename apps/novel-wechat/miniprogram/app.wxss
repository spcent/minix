.page {
  min-height: 100vh;
  padding: 32rpx;
  background:
    radial-gradient(circle at top left, #f7eede 0%, transparent 34%),
    linear-gradient(180deg, #f6efe8 0%, #eef1f6 100%);
  box-sizing: border-box;
}

.hero {
  margin-bottom: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 16rpx 40rpx rgba(15, 23, 42, 0.08);
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #0f172a;
}

.subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.6;
}

.section-label,
.section-title {
  margin-bottom: 12rpx;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: #5c677d;
}

.item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}

.item:last-child {
  border-bottom: 0;
}

.item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #14213d;
}

.button {
  margin-top: 24rpx;
}

.header-menu,
.footer-nav {
  margin-bottom: 24rpx;
}

.workspace-menu,
.execution-menu,
.profile-menu,
.landing-menu {
  display: grid;
  gap: 20rpx;
}

.brand-block {
  display: grid;
  gap: 6rpx;
}

.brand-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #14213d;
}

.brand-subtitle,
.footer-copy,
.reason-text,
.status-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: #64748b;
}

.menu-title,
.footer-title {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: #5c677d;
}

.nav-row,
.chip-row,
.item-meta,
.button-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.nav-chip,
.plan-chip,
.item-badge {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #eef1f6;
  color: #334155;
  font-size: 22rpx;
}

.nav-chip-active {
  background: #14213d;
  color: #ffffff;
}

.nav-chip-link {
  border: 1rpx solid #d7dde7;
  background: #ffffff;
}

.item-badge-soft,
.plan-chip {
  background: #f6efe8;
  color: #8a5d3b;
}

.summary-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 16rpx;
}

.summary-stat {
  padding: 20rpx;
  border-radius: 20rpx;
  background: #f8fafc;
}

.summary-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #14213d;
  word-break: break-word;
}

.summary-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.5;
}

.button-inline {
  margin-top: 0;
}
